# [TEMPLATE] bat/config
# 部署目标: ~/.config/bat/config

# 主题：bat 没有内置 GitHub Light Colorblind 主题。
# 用 "ansi" 让 bat 走终端 ANSI 配色（自动跟随 Rex 的终端主题），
# 保证视觉一致 + colorblind 安全（语法高亮颜色由 ANSI 16 色推导）。
--theme="ansi"

# 行号 + Git 修改状态条
--style="numbers,changes,header"

# 自动检测语言
--map-syntax="*.ignore:Git Ignore"
--map-syntax=".env*:Bash"
