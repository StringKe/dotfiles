                },
                "supergemma4-26b-uncensored": {
                    "name": "SuperGemma 4 26B · Uncensored",
                    "capabilities": {
                        "tools": true,
                        "input": [
                            "text",
                            "image"
                        ],
                        "output": [
                            "text"
                        ]
                    },
                    "cost": {
                        "input": 0.195,
                        "output": 0.6
                    },
                    "limit": {
                        "context": 256000,
                        "output": 8192
                    }
                },
                "gemma-4-26b-a4b-it-uncensored": {
                    "name": "Gemma 4 26B A4B · Uncensored",
                    "capabilities": {
                        "tools": true,
                        "input": [
                            "text",
                            "image"
                        ],
                        "output": [
                            "text"
                        ]
                    },
                    "cost": {
                        "input": 0.48,
                        "output": 0.96
                    },
                    "limit": {
                        "context": 32768,
                        "output": 32768
                    }
                },
                "gemma-4-31b-abliterated": {
                    "name": "Gemma 4 31B · Abliterated",
                    "capabilities": {
                        "tools": true,
                        "input": [
                            "text",
                            "image"
                        ],
                        "output": [
                            "text"
                        ]
                    },
                    "cost": {
                        "input": 0.144,
                        "output": 0.432
                    },
                    "limit": {
                        "context": 32768,
                        "output": 32768
                    }
                },
                "gemma-4-31b-uncensored": {
                    "name": "Gemma 4 31B · Uncensored",
                    "capabilities": {
                        "tools": true,
                        "input": [
                            "text"
                        ],
                        "output": [
                            "text"
                        ]
                    },
                    "cost": {
                        "input": 0.576,
                        "output": 1.728
                    },
                    "limit": {
                        "context": 32768,
                        "output": 32768
                    }
                }
            }
        },
        "omlx": {
            "name": "oMLX",
            "package": "@opencode/ai/providers/openai-compatible",
            "settings": {
                "baseURL": "http://127.0.0.1:45781/v1",
                "apiKey": "{env:OMLX_API_KEY}"
            },
            "models": {
                "tg-triage": {
                    "name": "Qwen3.6 35B A3B 6bit · tg-triage · 本地",
                    "capabilities": {
                        "tools": true,
                        "input": [
                            "text",
                            "image"
                        ],
                        "output": [
                            "text"
                        ]
                    },
                    "limit": {
                        "context": 32768,
                        "output": 2048
                    }
                }
            }
        }
    },
    // unlid 上游单次请求体上限约 4.5MB，截图压成小 JPEG 才能在一轮里多放几张
    "media": {
        "image": {
            "auto_resize": true,
            "max_width": 1568,
            "max_height": 1568,
            "max_base64_bytes": 400000
        }
    },
    "permission": "allow",
    // 与 ai/claude/mcp.json 保持同一组 MCP
    "mcp": {
        "context7": {
            "type": "remote",
            "url": "https://mcp.context7.com/mcp",
            "enabled": true,
            "headers": {
                "Authorization": "Bearer {env:MCP_CONTEXT7_API_KEY}"
            }
        },
        "exa": {
            "type": "remote",
            "url": "https://mcp.exa.ai/mcp?tools=web_search_exa,web_fetch_exa,web_search_advanced_exa",
            "enabled": true,
            "headers": {
                "x-api-key": "{env:MCP_EXA_API_KEY}"
            }
        },
        "rea": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "rea-agents@6.4.0",
                "mcp"
            ],
            "enabled": true,
            "environment": {
                "HOPPER_LAUNCHER_PATH": "{env:HOME}/Applications/Hopper Disassembler.app/Contents/MacOS/hopper"
            }
        },
        "paper": {
            "type": "local",
            "command": [
                "{env:HOME}/.paper/bin/paper",
                "mcp"
            ],
            "enabled": true
        }
    }
}
