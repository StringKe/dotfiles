{
    "$schema": "https://opencode.ai/config.json",
    // provider 在本机 ~/.config/opencode/opencode.json（不进仓库）。上游单次请求体上限约 4.5MB，截图压成小 JPEG 才能在一轮里多放几张
    "media": {
        "image": {
            "auto_resize": true,
            "max_width": 1568,
            "max_height": 1568,
            "max_base64_bytes": 400000
        }
    },
    "permission": "allow",
    // 与 ai/claude/mcp.json 保持同一组 MCP；rea 只在这里启用
    "mcp": {
        "context7": {
            "type": "remote",
            "url": "https://mcp.context7.com/mcp",
            "enabled": true,
            "headers": {
                "Authorization": "Bearer {env:MCP_CONTEXT7_API_KEY}"
            }
        },
        "exa": {
            "type": "remote",
            "url": "https://mcp.exa.ai/mcp?tools=web_search_exa,web_fetch_exa,web_search_advanced_exa",
            "enabled": true,
            "headers": {
                "x-api-key": "{env:MCP_EXA_API_KEY}"
            }
        },
        "gh_grep": {
            "type": "remote",
            "url": "https://mcp.grep.app",
            "enabled": true
        },
        "openseo": {
            "type": "remote",
            "url": "https://app.openseo.so/mcp",
            "enabled": true,
            "headers": {
                "Authorization": "Bearer {env:OPENSEO_API_KEY}"
            }
        },
        "truewatch": {
            "type": "remote",
            "url": "https://ap1-owl-mcp.truewatch.com/mcp",
            "enabled": true,
            "headers": {
                "Authorization": "Bearer {env:TRUEWATCH_API_KEY}"
            }
        },
        "fingerprint": {
            "type": "local",
            "command": [
                "fingerprint-mcp-server",
                "--region",
                "ap"
            ],
            "enabled": true,
            "environment": {
                "FINGERPRINT_SERVER_API_KEY": "{env:FINGERPRINT_SERVER_API_KEY}",
                "FINGERPRINT_MANAGEMENT_API_KEY": "{env:FINGERPRINT_MANAGEMENT_API_KEY}"
            }
        },
        "rea": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "rea-agents@6.4.0",
                "mcp"
            ],
            "enabled": true,
            "environment": {
                "HOPPER_LAUNCHER_PATH": "{env:HOME}/Applications/Hopper Disassembler.app/Contents/MacOS/hopper"
            }
        },
        "paper": {
            "type": "local",
            "command": [
                "{env:HOME}/.paper/bin/paper",
                "mcp"
            ],
            "enabled": true
        },
        "slack": {
            "type": "local",
            "command": [
                "slack-mcp-server",
                "--transport",
                "stdio"
            ],
            "enabled": true,
            "environment": {
                "SLACK_MCP_XOXP_TOKEN": "{env:SLACK_MCP_XOXP_TOKEN}",
                "SLACK_MCP_ADD_MESSAGE_TOOL": "true",
                "SLACK_MCP_ADD_MESSAGE_MARK": "true",
                "SLACK_MCP_USERS_CACHE": "{env:HOME}/.cache/slack-mcp/users_cache.json",
                "SLACK_MCP_CHANNELS_CACHE": "{env:HOME}/.cache/slack-mcp/channels_cache_v2.json"
            }
        }
    }
}
