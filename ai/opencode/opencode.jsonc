{
    "$schema": "https://opencode.ai/config.json",
    "providers": {
        "unlid": {
            "name": "Unlid",
            "env": [
                "UNLID_API_KEY"
            ],
            "package": "@opencode/ai/providers/openai-compatible",
            "settings": {
                "baseURL": "https://api.unlid.ai/v1"
            },
            "models": {
                "glm-5.3-flash-uncensored": {
                    "name": "GLM 5.3 Flash · Uncensored",
                    "capabilities": {
                        "tools": true,
                        "input": [
                            "text",
                            "image"
                        ],
                        "output": [
                            "text"
                        ]
                    },
                    "compatibility": {
                        "reasoningField": "reasoning_content"
                    },
                    "cost": {
                        "input": 0.24,
                        "output": 0.96,
                        "cache": {
                            "read": 0.084
                        }
                    },
                    "limit": {
                        "context": 262144
                    }
                },
                "qwen3.8-27b-uncensored": {
                    "name": "Qwen3.8 27B · Uncensored",
                    "capabilities": {
                        "tools": false,
                        "input": [
                            "text",
                            "image"
                        ],
                        "output": [
                            "text"
                        ]
                    },
                    "compatibility": {
                        "reasoningField": "reasoning_content"
                    },
                    "cost": {
                        "input": 0.3,
                        "output": 1.8,
                        "cache": {
                            "read": 0.156
                        }
                    },
                    "limit": {
                        "context": 131072
                    }
                },
                "qwen3.8-27b-uncensored:thinking": {
                    "name": "Qwen3.8 27B · Uncensored · Thinking",
                    "capabilities": {
                        "tools": true,
                        "input": [
                            "text",
                            "image"
                        ],
                        "output": [
                            "text"
                        ]
                    },
                    "compatibility": {
                        "reasoningField": "reasoning_content"
                    },
                    "cost": {
                        "input": 0.18,
                        "output": 1.44,
                        "cache": {
                            "read": 0.15
                        }
                    },
                    "limit": {
                        "context": 262144,
                        "output": 32768
                    }
                },
                "qwen3.8-27b-abliterated": {
                    "name": "Qwen3.8 27B · Abliterated",
                    "capabilities": {
                        "tools": true,
                        "input": [
                            "text",
                            "image"
                        ],
                        "output": [
                            "text"
                        ]
                    },
                    "compatibility": {
                        "reasoningField": "reasoning_content"
                    },
                    "cost": {
                        "input": 1.2,
                        "output": 9
                    },
                    "limit": {
                        "context": 32768,
                        "output": 32768
                    }
                },
                "qwen3.8-27b-cybersecurity": {
                    "name": "Qwen3.8 27B · Cybersecurity",
                    "capabilities": {
                        "tools": true,
                        "input": [
                            "text",
                            "image"
                        ],
                        "output": [
                            "text"
                        ]
                    },
                    "compatibility": {
                        "reasoningField": "reasoning_content"
                    },
                    "cost": {
                        "input": 0.12,
                        "output": 0.72,
                        "cache": {
                            "read": 0.06
                        }
                    },
                    "limit": {
                        "context": 262144
                    }
                },
                "qwen3.5-9b-abliterated": {
                    "name": "Qwen3.5 9B · Abliterated",
                    "capabilities": {
                        "tools": true,
                        "input": [
                            "text",
                            "image"
                        ],
                        "output": [
                            "text"
                        ]
                    },
                    "compatibility": {
                        "reasoningField": "reasoning_content"
                    },
                    "cost": {
                        "input": 0.816,
                        "output": 1.2
                    },
                    "limit": {
                        "context": 32768,
                        "output": 32768
                    }
                },
                "glm-5.3-flash-cybersecurity": {
                    "name": "GLM 5.3 Flash · Cybersecurity",
                    "capabilities": {
                        "tools": true,
                        "input": [
                            "text"
                        ],
                        "output": [
                            "text"
                        ]
                    },
                    "cost": {
                        "input": 0.18,
                        "output": 0.6,
                        "cache": {
                            "read": 0.09
                        }
                    },
                    "limit": {
                        "context": 1000000
                    }
                },
                "glm-4.7-flash-heretic": {
                    "name": "GLM 4.7 Flash · Heretic",
                    "capabilities": {
                        "tools": true,
                        "input": [
                            "text"
                        ],
                        "output": [
                            "text"
                        ]
                    },
                    "compatibility": {
                        "reasoningField": "reasoning_content"
                    },
                    "cost": {
                        "input": 0.084,
                        "output": 0.48,
                        "cache": {
                            "read": 0.042
                        }
                    },
                    "limit": {
                        "context": 131072,
                        "output": 24000
                    }
                },
                "abliterated-model-large-v2": {
                    "name": "Abliterated Model Large v2 (GLM 5.3 base)",
                    "capabilities": {
                        "tools": true,
                        "input": [
                            "text"
                        ],
                        "output": [
                            "text"
                        ]
                    },
                    "compatibility": {
                        "reasoningField": "reasoning_content"
                    },
                    "cost": {
                        "input": 3.6,
                        "output": 6,
                        "cache": {
                            "read": 0.36
                        }
                    },
                    // 上游 max_output 999990；unlid 按 max_tokens × 输出单价预扣余额，取 32768 避免 402
                    "limit": {
                        "context": 1000000,
                        "output": 32768
                    }
                },
                "abliterated-model": {
                    "name": "Abliterated Model (multimodal)",
                    "capabilities": {
                        "tools": true,
                        "input": [
                            "text",
                            "image"
                        ],
                        "output": [
                            "text"
                        ]
                    },
                    "compatibility": {
                        "reasoningField": "reasoning_content"
                    },
                    "cost": {
                        "input": 1.2,
                        "output": 3.6,
                        "cache": {
                            "read": 0.12
                        }
                    },
                    // 上游 max_output 262134，同上
                    "limit": {
                        "context": 262144,
                        "output": 32768
                    }
                },
                "dolphin-mistral-24b-uncensored": {
                    "name": "Dolphin Mistral 24B · Uncensored",
                    "capabilities": {
                        "tools": true,
                        "input": [
                            "text",
                            "image"
                        ],
                        "output": [
                            "text"
                        ]
                    },
                    "cost": {
                        "input": 0.24,
                        "output": 1.08
