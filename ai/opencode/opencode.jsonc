{
    "agents": {
        "compaction": {
            "model": "magpie/group/worker"
        },
        "explore": {
            "model": "magpie/group/fast"
        },
        "general": {
            "model": "magpie/group/worker"
        },
        "summary": {
            "model": "magpie/group/fast"
        },
        "title": {
            "model": "magpie/group/fast"
        }
    },
    "model": "magpie/group/brain",
    "providers": {
        "magpie": {
            "compatibility": {
                "supportsPromptCacheKey": true
            },
            "models": {
                "group/worker": {
                    "capabilities": {
                        "input": [
                            "text",
                            "image"
                        ],
                        "output": [
                            "text"
                        ],
                        "tools": true
                    },
                    "cost": [
                        {
                            "cache": {
                                "read": 0.1,
                                "write": 2.5
                            },
                            "input": 2,
                            "output": 10
                        }
                    ],
                    "limit": {
                        "context": 1000000,
                        "output": 128000
                    },
                    "name": "Worker · routing group",
                    "variants": [
                        {
                            "id": "low",
                            "settings": {
                                "reasoningEffort": "low"
                            }
                        },
                        {
                            "id": "medium",
                            "settings": {
                                "reasoningEffort": "medium"
                            }
                        },
                        {
                            "id": "high",
                            "settings": {
                                "reasoningEffort": "high"
                            }
                        },
                        {
                            "id": "xhigh",
                            "settings": {
                                "reasoningEffort": "xhigh"
                            }
                        },
                        {
                            "id": "max",
                            "settings": {
                                "reasoningEffort": "max"
                            }
                        },
                        {
                            "id": "ultra",
                            "settings": {
                                "reasoningEffort": "ultra"
                            }
                        }
                    ]
                },
                "group/fast": {
                    "capabilities": {
                        "input": [
                            "text",
                            "image"
                        ],
                        "output": [
                            "text"
                        ],
                        "tools": true
                    },
                    "cost": [
                        {
                            "cache": {
                                "read": 0.01,
                                "write": 0.125
                            },
                            "input": 0.1,
                            "output": 0.5
                        }
                    ],
                    "limit": {
                        "context": 1000000,
                        "output": 128000
                    },
                    "name": "Fast · routing group",
                    "variants": [
                        {
                            "id": "low",
                            "settings": {
                                "reasoningEffort": "low"
                            }
                        },
                        {
                            "id": "medium",
                            "settings": {
                                "reasoningEffort": "medium"
                            }
                        },
                        {
                            "id": "high",
                            "settings": {
                                "reasoningEffort": "high"
                            }
                        },
                        {
                            "id": "xhigh",
                            "settings": {
                                "reasoningEffort": "xhigh"
                            }
                        }
                    ]
                },
                "group/brain": {
                    "capabilities": {
                        "input": [
                            "text",
                            "image"
                        ],
                        "output": [
                            "text"
                        ],
                        "tools": true
                    },
                    "cost": [
                        {
                            "cache": {
                                "read": 0.2,
                                "write": 5
                            },
                            "input": 4,
                            "output": 20
                        }
                    ],
                    "limit": {
                        "context": 1000000,
                        "output": 500000
                    },
                    "name": "Brain · routing group",
                    "variants": [
                        {
                            "id": "low",
                            "settings": {
                                "reasoningEffort": "low"
                            }
                        },
                        {
                            "id": "medium",
                            "settings": {
                                "reasoningEffort": "medium"
                            }
                        },
                        {
                            "id": "high",
                            "settings": {
                                "reasoningEffort": "high"
                            }
                        },
                        {
                            "id": "xhigh",
                            "settings": {
                                "reasoningEffort": "xhigh"
                            }
                        }
                    ]
                },
                "group/deep": {
                    "capabilities": {
                        "input": [
                            "text",
                            "image"
                        ],
                        "output": [
                            "text"
                        ],
                        "tools": true
                    },
                    "cost": [
                        {
                            "cache": {
                                "read": 0.2,
                                "write": 10
                            },
                            "input": 8,
                            "output": 40
                        }
                    ],
                    "limit": {
                        "context": 1000000,
                        "output": 128000
                    },
                    "name": "Deep · routing group",
                    "variants": [
                        {
                            "id": "low",
                            "settings": {
                                "reasoningEffort": "low"
                            }
                        },
                        {
                            "id": "medium",
                            "settings": {
                                "reasoningEffort": "medium"
                            }
                        },
                        {
                            "id": "high",
                            "settings": {
                                "reasoningEffort": "high"
                            }
                        },
                        {
                            "id": "xhigh",
                            "settings": {
                                "reasoningEffort": "xhigh"
                            }
                        },
                        {
                            "id": "max",
                            "settings": {
                                "reasoningEffort": "max"
                            }
                        },
                        {
                            "id": "ultra",
                            "settings": {
                                "reasoningEffort": "ultra"
                            }
                        }
                    ]
                }
            },
            "name": "magpie",
            "package": "aisdk:@ai-sdk/openai-compatible",
            "settings": {
                "apiKey": "magpie",
                "baseURL": "http://127.0.0.1:3425/v1"
            }
        }
    },
    "$schema": "https://opencode.ai/config.json",
    // provider 在本机 ~/.config/opencode/opencode.json（不进仓库）。上游单次请求体上限约 4.5MB，截图压成小 JPEG 才能在一轮里多放几张
    "media": {
        "image": {
            "auto_resize": true,
            "max_width": 1568,
            "max_height": 1568,
            "max_base64_bytes": 400000
        }
    },
    "permission": "allow",
    // 与 ai/claude/mcp.json 保持同一组 MCP；rea 只在这里启用
    "mcp": {
        "magpie": {
            "type": "remote",
            "url": "http://127.0.0.1:3425/mcp/magpie/hub/opencode",
            "enabled": true
        },
        "slack": {
            "type": "local",
            "command": [
                "slack-mcp-server",
                "--transport",
                "stdio"
            ],
            "enabled": true,
            "environment": {
                "SLACK_MCP_XOXP_TOKEN": "{env:SLACK_MCP_XOXP_TOKEN}",
                "SLACK_MCP_ADD_MESSAGE_TOOL": "true",
                "SLACK_MCP_ADD_MESSAGE_MARK": "true",
                "SLACK_MCP_USERS_CACHE": "{env:HOME}/.cache/slack-mcp/users_cache.json",
                "SLACK_MCP_CHANNELS_CACHE": "{env:HOME}/.cache/slack-mcp/channels_cache_v2.json"
            }
        }
    }
}
