{
  "context7": {
    "type": "http",
    "url": "https://mcp.context7.com/mcp",
    "headers": {
      "Authorization": "Bearer ${MCP_CONTEXT7_API_KEY}"
    }
  },
  "exa": {
    "type": "http",
    "url": "https://mcp.exa.ai/mcp?tools=web_search_exa,web_fetch_exa,web_search_advanced_exa",
    "headers": {
      "x-api-key": "${MCP_EXA_API_KEY}"
    }
  },
  "gh_grep": {
    "type": "http",
    "url": "https://mcp.grep.app"
  },
  "openseo": {
    "type": "http",
    "url": "https://app.openseo.so/mcp",
    "headers": {
      "Authorization": "Bearer ${OPENSEO_API_KEY}"
    }
  },
  "truewatch": {
    "type": "http",
    "url": "https://ap1-owl-mcp.truewatch.com/mcp",
    "headers": {
      "Authorization": "Bearer ${TRUEWATCH_API_KEY}"
    }
  },
  "fingerprint": {
    "type": "stdio",
    "command": "fingerprint-mcp-server",
    "args": ["--region", "ap"],
    "env": {
      "FINGERPRINT_SERVER_API_KEY": "${FINGERPRINT_SERVER_API_KEY}",
      "FINGERPRINT_MANAGEMENT_API_KEY": "${FINGERPRINT_MANAGEMENT_API_KEY}"
    }
  },
  "paper": {
    "type": "stdio",
    "command": "${HOME}/.paper/bin/paper",
    "args": ["mcp"]
  },
  "slack": {
    "type": "stdio",
    "command": "slack-mcp-server",
    "args": ["--transport", "stdio"],
    "env": {
      "SLACK_MCP_XOXP_TOKEN": "${SLACK_MCP_XOXP_TOKEN}",
      "SLACK_MCP_ADD_MESSAGE_TOOL": "true",
      "SLACK_MCP_ADD_MESSAGE_MARK": "true",
      "SLACK_MCP_USERS_CACHE": "${HOME}/.cache/slack-mcp/users_cache.json",
      "SLACK_MCP_CHANNELS_CACHE": "${HOME}/.cache/slack-mcp/channels_cache_v2.json"
    }
  }
}
