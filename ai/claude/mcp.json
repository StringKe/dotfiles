{
  "context7": {
    "type": "http",
    "url": "https://mcp.context7.com/mcp",
    "headers": {
      "Authorization": "Bearer ${MCP_CONTEXT7_API_KEY}"
    }
  },
  "exa": {
    "type": "http",
    "url": "https://mcp.exa.ai/mcp?tools=web_search_exa,web_fetch_exa,web_search_advanced_exa",
    "headers": {
      "x-api-key": "${MCP_EXA_API_KEY}"
    }
  },
  "gh_grep": {
    "type": "http",
    "url": "https://mcp.grep.app"
  },
  "openseo": {
    "type": "http",
    "url": "https://app.openseo.so/mcp",
    "headers": {
      "Authorization": "Bearer ${OPENSEO_API_KEY}"
    }
  },
  "sentry": {
    "type": "http",
    "url": "https://mcp.sentry.dev/mcp",
    "headers": {
      "Authorization": "Sentry-Bearer ${SENTRY_ACCESS_TOKEN}"
    }
  },
  "fingerprint": {
    "type": "stdio",
    "command": "fingerprint-mcp-server",
    "args": ["--region", "ap"],
    "env": {
      "FINGERPRINT_SERVER_API_KEY": "${FINGERPRINT_SERVER_API_KEY}",
      "FINGERPRINT_MANAGEMENT_API_KEY": "${FINGERPRINT_MANAGEMENT_API_KEY}"
    }
  },
  "rea": {
    "type": "stdio",
    "command": "npx",
    "args": ["-y", "rea-agents@6.4.0", "mcp"],
    "env": {
      "HOPPER_LAUNCHER_PATH": "${HOME}/Applications/Hopper Disassembler.app/Contents/MacOS/hopper"
    }
  },
  "paper": {
    "type": "stdio",
    "command": "${HOME}/.paper/bin/paper",
    "args": ["mcp"]
  }
}
