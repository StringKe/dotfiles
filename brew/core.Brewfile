# core：shell 与日常 CLI（必选）。zsh 配置、init.zsh 的别名和 hook 依赖这里的工具。

# Shell 与提示符
brew "zsh"
brew "starship"        # 跨 shell 提示符
brew "tmux"            # 终端复用，agent 跑 TUI 测试也用

# 效率工具
brew "atuin"           # 智能历史搜索
brew "fzf"             # 模糊搜索
brew "zoxide"          # 智能目录跳转
brew "yazi"            # 终端文件管理器
brew "eza"             # 现代 ls 替代
brew "fd"              # 现代 find 替代
brew "ripgrep"         # 现代 grep 替代
brew "bat"             # 现代 cat 替代（语法高亮）
brew "btop"            # 系统监控
brew "tree"            # 目录树
brew "jq"              # JSON 处理
brew "yq"              # YAML 处理
brew "lazygit"         # Git TUI

# 文件
brew "macos-trash"     # 安全删除（Finder 回收站），init.zsh 的 rm 包装依赖它
brew "coreutils"       # GNU 核心工具（g 前缀；不冲突短名如 timeout 已链到 prefix）
brew "dust"            # 目录占用分析
brew "sevenzip"        # 7z 压缩

# Git
brew "git"
brew "gh"              # GitHub CLI，git/config 的 credential helper
brew "pre-commit"      # Git hooks（本仓库用它跑 gitleaks）

# 运行时与环境
brew "mise"            # 多语言版本管理
brew "direnv"          # 目录环境变量
brew "curl"

# 系统集成
brew "infat"           # 声明式文件类型关联
brew "duti"            # 命令式文件关联（补 infat 之外的细粒度）
brew "mas"             # App Store CLI
brew "qrencode"        # 二维码生成

# 字体：终端与 VS Code 统一 Maple Mono NF CN
cask "font-maple-mono-nf-cn"
