# dev：通用开发辅助（编译工具链、linter、本地服务、数据库客户端、密钥文件）

brew "gcc"             # GNU 编译器套件
brew "llvm"            # LLVM/Clang（keg-only，PATH 在系统命令之后）
brew "golangci-lint"   # Go linter
brew "yamllint"        # YAML linter
brew "cloc"            # 代码行统计
brew "caddy"           # 本地反向代理 / HTTPS
brew "age"             # 文件加密
brew "sops"            # 密钥文件加解密

# 数据库：server 走 OrbStack docker，本机只留 client
brew "mysql-client"    # keg-only，zshenv 放进 PATH
brew "duckdb"          # 本地分析 JSON / CSV / Parquet
