{
  "workbench.colorTheme": "GitHub Light Colorblind (Beta)",
  "workbench.iconTheme": "material-icon-theme",
  "workbench.preferredLightColorTheme": "GitHub Light Colorblind (Beta)",
  "workbench.preferredDarkColorTheme": "GitHub Light Colorblind (Beta)",

  "editor.fontFamily": "'Maple Mono NF CN', Menlo, Monaco, monospace",
  "terminal.integrated.fontFamily": "'Maple Mono NF CN', Menlo, monospace",

  "editor.fontLigatures": true,
  "editor.minimap.enabled": false,
  "editor.smoothScrolling": true,
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": "active",

  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,

  "explorer.compactFolders": false,
  "extensions.ignoreRecommendations": true,

  "telemetry.telemetryLevel": "off",
  "update.mode": "default"
}
