# [TEMPLATE] ghostty/config
# 部署目标: ~/Library/Application Support/com.mitchellh.ghostty/config
# AI 部署时复制此文件，不修改本文件。
#
# macOS 26.5 · Ghostty 1.3.1+ · tip channel
# 设计目标：extend padding 无缝外观 + tab 标题正常显示 + Tahoe 标题栏稳定

# ══════════════════════════════════════════════════════════════════════════════
# Appearance
# ══════════════════════════════════════════════════════════════════════════════

font-family = "Maple Mono NF CN"
font-style = SemiBold
font-size = 16
# 用字体自带 SemiBold，不用 CoreText thicken 描边
font-thicken = false
font-feature = +calt
font-feature = +liga

theme = GitHub Light Colorblind
window-theme = light
window-colorspace = display-p3
alpha-blending = native

# ══════════════════════════════════════════════════════════════════════════════
# Window
# ══════════════════════════════════════════════════════════════════════════════

window-height = 48
window-width = 160
window-decoration = client
window-vsync = true

# default：跟随 macOS；avoid always（#3049 tabs+extend 恢复闪烁）
window-save-state = default
window-new-tab-position = current

# 不设全局 title — 会覆盖所有 tab 标题；由 shell integration 动态
# title = " "

# ══════════════════════════════════════════════════════════════════════════════
# Padding（extend 必须保留）
# ══════════════════════════════════════════════════════════════════════════════

window-padding-color = extend
window-padding-balance = true
# 上 0：titlebar 已占顶部空间；左右/下适度留白
window-padding-x = 4,4
window-padding-y = 0,4

# 不使用透明度/毛玻璃 — macOS 26 + tab 会致标题栏异常（#10104 #5432）
# background-opacity = 1.0
# background-blur = false

# ══════════════════════════════════════════════════════════════════════════════
# macOS titlebar
# ══════════════════════════════════════════════════════════════════════════════

# transparent：官方默认，与 extend 最搭；Tahoe 上比 tabs 稳定（#12818 #9946）
macos-titlebar-style = transparent
macos-titlebar-proxy-icon = hidden

# 若要用 tabs 集成标题栏，取消下行注释并注释掉 transparent 行（Tahoe 可能仍有闪烁）
# macos-titlebar-style = tabs

macos-option-as-alt = left
macos-auto-secure-input = true

# ══════════════════════════════════════════════════════════════════════════════
# Auto-update（macOS only）
# ══════════════════════════════════════════════════════════════════════════════

auto-update = download
auto-update-channel = tip

# ═══════════════════════════════════════════════════════════════
# Working directory
# ═══════════════════════════════════════════════════════════════

window-inherit-working-directory = true
tab-inherit-working-directory = true
split-inherit-working-directory = true

# ═══════════════════════════════════════════════════════════════
# Scroll
# ═══════════════════════════════════════════════════════════════

# 每 surface（tab/split）上限约 500MB；内存充裕时故意保留大回滚。
# 改限值只影响新 surface。compression 空闲时压缩页，吞吐路径不降速。
scrollback-limit = 524288000
scrollback-compression = true
scrollbar = system
mouse-scroll-multiplier = precision:0.5
mouse-hide-while-typing = true

# ══════════════════════════════════════════════════════════════════════════════
# Clipboard
# ══════════════════════════════════════════════════════════════════════════════

copy-on-select = clipboard
clipboard-read = allow
clipboard-write = allow

# ══════════════════════════════════════════════════════════════════════════════
# Split
# ══════════════════════════════════════════════════════════════════════════════

unfocused-split-opacity = 0.85
split-preserve-zoom = navigation

# ═══════════════════════════════════════════════════════════════
# Interaction（1.3+）
# ═══════════════════════════════════════════════════════════════

link-url = true
cursor-click-to-move = true

notify-on-command-finish = unfocused
notify-on-command-finish-action = no-bell,notify
notify-on-command-finish-after = 30s

# ══════════════════════════════════════════════════════════════════════════════
# Behavior
# ══════════════════════════════════════════════════════════════════════════════

confirm-close-surface = false
quit-after-last-window-closed = true

# ══════════════════════════════════════════════════════════════════════════════
# Shell integration
# ══════════════════════════════════════════════════════════════════════════════

shell-integration = zsh
# title：tab 显示目录/命令；path：确保 ghostty CLI 在 PATH 中
# ssh-terminfo：首次 ssh 到某台机器时把 xterm-ghostty 装过去；ssh-env：装不上时退回 xterm-256color
shell-integration-features = cursor,sudo,title,path,ssh-env,ssh-terminfo

# ══════════════════════════════════════════════════════════════════════════════
# Keybinds
# ══════════════════════════════════════════════════════════════════════════════

# 复制粘贴：覆盖 tip 默认的 performable:super+c/v。
# performable 键不会进菜单 reverse map，Edit 菜单不显示 ⌘C/⌘V；
# 且搜索框（⌘F）聚焦时键事件不走 first responder，⌘V 无法贴进搜索框。
# 去掉 performable 后：菜单显示快捷键，⌘V 经菜单 paste: 交给当前 first responder。
# macOS 是 ⌘（super），不是 Ctrl。
keybind = super+c=copy_to_clipboard:mixed
keybind = super+v=paste_from_clipboard
keybind = super+a=select_all

# Shift+Enter 插入换行（Claude Code / 多行输入）
keybind = shift+enter=text:\n

# 关掉官方默认 super+enter=toggle_fullscreen（误触全屏）；
# 全屏只保留 macOS / Ghostty 默认的 super+ctrl+f（⌃⌘F）
keybind = super+enter=unbind

# 防误触退出：cmd+q 失效（confirm-close-surface = false 时 cmd+q 会静默杀掉
# 所有 tab）；有意退出用 cmd+shift+q 或菜单 Ghostty > Quit
keybind = super+q=ignore
keybind = super+shift+q=quit

# Split：cmd+d/cmd+shift+d（右/下）是 ghostty 官方默认，钉住不依赖隐式
# 默认；new_split 其实支持 left/up 参数，官方默认没给键位，这里用同一个
# d 字母补上（不加修饰键=右，+shift=下，+alt=左，+ctrl=上）
keybind = super+d=new_split:right
keybind = super+shift+d=new_split:down
keybind = super+alt+d=new_split:left
keybind = super+ctrl+d=new_split:up
keybind = super+[=goto_split:previous
keybind = super+]=goto_split:next
keybind = super+alt+arrow_up=goto_split:up
keybind = super+alt+arrow_down=goto_split:down
keybind = super+alt+arrow_left=goto_split:left
keybind = super+alt+arrow_right=goto_split:right
keybind = super+ctrl+arrow_up=resize_split:up,10
keybind = super+ctrl+arrow_down=resize_split:down,10
keybind = super+ctrl+arrow_left=resize_split:left,10
keybind = super+ctrl+arrow_right=resize_split:right,10
keybind = super+ctrl+==equalize_splits
keybind = super+shift+enter=toggle_split_zoom
