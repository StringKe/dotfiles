# [TEMPLATE] ghostty/config
# 部署目标: ~/Library/Application Support/com.mitchellh.ghostty/config
# AI 部署时复制此文件，不修改本文件。

# 字体
font-family = JetBrainsMonoNL Nerd Font Mono
font-size = 15
font-thicken = true

# 主题（Catppuccin Latte，与其他工具对齐）
theme = catppuccin-latte

# 窗口
window-height = 48
window-width = 160
window-padding-x = 4
window-padding-y = 4
window-save-state = always
window-inherit-working-directory = true
window-vsync = true

# 标签页和分屏继承工作目录
tab-inherit-working-directory = true
split-inherit-working-directory = true

# 滚动
scrollback-limit = 524288000
scrollbar = system
mouse-scroll-multiplier = precision:0.5
mouse-hide-while-typing = true

# 剪贴板
copy-on-select = clipboard
clipboard-read = allow
clipboard-write = allow

# 渲染
background-opacity = 1
alpha-blending = native
minimum-contrast = 1.1

# 分屏
unfocused-split-opacity = 0.85
split-preserve-zoom = navigation

# 行为
confirm-close-surface = false
quit-after-last-window-closed = true
quit-after-last-window-closed-delay = 1m

# macOS：自绘 tabs 标题栏（避开 Tahoe 液态玻璃），减少动画
macos-titlebar-style = tabs
macos-titlebar-proxy-icon = hidden
macos-option-as-alt = true
macos-window-shadow = false
window-theme = ghostty
window-padding-balance = true
resize-overlay = never
quick-terminal-animation-duration = 0

# Shell
shell-integration = zsh
