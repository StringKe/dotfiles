# ============================================================
# ~/.zimrc - zimfw 模块清单
#
# 加载顺序对应 zimfw 编译的 init.zsh 执行顺序：
#   environment / input               - 核心 zsh 行为 + 键绑定
#   zsh-completions (fpath) + completion - 补全字典扩展 + compinit
#   fzf-tab                           - Tab 补全 UI (compinit 之后)
#   fzf-tab-source                    - fzf-tab 预览增强
#   zsh-defer                         - 异步加载框架 (供 init.zsh 用)
#   direnv                            - 目录级 env (precmd hook, 必须同步)
#   zsh-syntax-highlighting           - 语法高亮 (zle hook 必须同步)
#   zsh-autosuggestions               - 自动建议 (依赖高亮)
#   $DOTFILES_ROOT/init.zsh           - 本仓的别名 / 工具激活 (zsh-defer 异步)
#
# 模板路径：dotfiles/zsh/zimrc
# ============================================================

zmodule environment
zmodule input

zmodule zsh-users/zsh-completions --fpath src
zmodule completion

zmodule Aloxaf/fzf-tab
zmodule Freed-Wu/fzf-tab-source

# 异步加载框架。用法 (init.zsh)：zsh-defer eval "$(some-tool init zsh)"
# 把 starship/atuin/zoxide/mise/fzf 等非 prompt-critical 的 init 全部移到 prompt
# 第一次绘制之后异步跑，prompt 立等可见。
zmodule romkatv/zsh-defer

zmodule zimfw/direnv

zmodule zsh-users/zsh-syntax-highlighting
zmodule zsh-users/zsh-autosuggestions

zmodule $DOTFILES_ROOT
