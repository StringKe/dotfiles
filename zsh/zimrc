# ============================================================
# [TEMPLATE] zsh/zimrc - zimfw 模块声明
#
# 部署目标: ~/.zimrc（由 bin/deploy.sh 复制）
#
# AI 规则:
#   - 此文件是仓库模板。AI 部署时复制到 ~/.zimrc，不修改本文件。
#   - 添加 zsh 插件 -> 编辑本文件后跑 bin/deploy.sh init 或 zimfw install。
#   - 别名/函数/工具激活 -> dotfiles/init.zsh，不放此处。
# ============================================================

# 核心行为（setopt auto_cd, pushd, extended_glob 等）
zmodule environment

# 键绑定（Home/End/Delete/Ctrl+Arrow 等）
zmodule input

# 补全系统（顺序重要：completions fpath -> compinit -> fzf-tab -> 高亮 -> 建议）
zmodule zsh-users/zsh-completions --fpath src
zmodule completion

# fzf-tab: Tab 补全使用 fzf 交互（必须在 compinit 之后、高亮之前）
zmodule Aloxaf/fzf-tab

# fzf-tab-source: fzf-tab 预览增强（make recipe、git log、kill 进程等）
zmodule Freed-Wu/fzf-tab-source

# direnv: 不用 zimfw/direnv 模块（同时挂 precmd+chpwd，每命令 265ms fork）
# 改在 ~/.zsh/init.zsh 自定义为 chpwd-only

# 语法高亮（必须在 completion 之后）
zmodule zsh-users/zsh-syntax-highlighting

# 自动建议（必须在高亮之后）
zmodule zsh-users/zsh-autosuggestions
