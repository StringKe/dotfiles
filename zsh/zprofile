# ============================================================
# ~/.zprofile - 登录 shell 配置（在 ~/.zshrc 之前加载）
#
# [AI 规则] 此文件只放登录时执行一次的配置，不要添加交互式工具。
#   - 仅放：Homebrew 环境变量、mise shims（非交互式登录 shell 用）
#   - 别名 / 函数 / prompt 初始化 -> DOTFILES_ROOT/init.zsh
#   - 环境变量 / PATH -> dotfiles/zsh/zshenv
#   - 此文件由 dotfiles 模板部署，修改会被重配覆盖
#   - 模板路径：dotfiles/zsh/zprofile
# ============================================================

# ============================================================
# Homebrew 初始化（带缓存）
# Apple Silicon 上 `brew shellenv` 单次 fork 耗时 ~1.8s（Ruby 启动慢），
# 每次新开 shell 都要等。其输出对同一 brew 版本是固定的（HOMEBREW_PREFIX
# / HOMEBREW_CELLAR / PATH / MANPATH / INFOPATH），可安全缓存到
# ~/.cache/brew-shellenv.zsh。brew 二进制更新（升级 / 重装）时缓存
# 自动失效（mtime 比较），重生即可。
# ============================================================
if [[ -x /opt/homebrew/bin/brew ]]; then
    _brew_env_cache="${XDG_CACHE_HOME:-$HOME/.cache}/brew-shellenv.zsh"
    if [[ ! -f $_brew_env_cache || /opt/homebrew/bin/brew -nt $_brew_env_cache ]]; then
        mkdir -p "${_brew_env_cache:h}"
        /opt/homebrew/bin/brew shellenv >| "$_brew_env_cache"
    fi
    source "$_brew_env_cache"
    unset _brew_env_cache
fi

# ============================================================
# mise - 运行时版本管理器 (shims 模式)
# 交互式 shell 由 init.zsh 的 mise activate 接管；
# 此处 --shims 仅用于 IDE/GUI 等非交互式登录 shell（不加载 ~/.zshrc 的进程）
# ============================================================
if command -v mise &>/dev/null && [[ ! -o interactive ]]; then
    eval "$(mise activate zsh --shims)"
fi
