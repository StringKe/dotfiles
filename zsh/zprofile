# ============================================================
# [TEMPLATE] zsh/zprofile - 登录 shell（在 zshrc 之前加载）
#
# 部署目标: ~/.zprofile（由 bin/deploy.sh 复制）
#
# AI 规则:
#   - 此文件是仓库模板，AI 部署时复制，不修改本文件。
#   - 只放登录时执行一次的环境配置（Homebrew env / mise shims）。
#   - 不放别名 / 函数 / prompt 初始化（-> dotfiles/init.zsh）。
#   - 不放交互式工具激活（-> dotfiles/init.zsh）。
# ============================================================

(( $+functions[_prof] )) && _prof "zprofile start"

# ============================================================
# Homebrew 初始化
# ============================================================
if [[ -f /opt/homebrew/bin/brew ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
fi
(( $+functions[_prof] )) && _prof "brew shellenv"

# ============================================================
# mise - 运行时版本管理器 (shims 模式)
# 交互式 shell 由 init.zsh 的 mise activate 接管；
# 此处 --shims 仅用于 IDE/GUI 等非交互式登录 shell（不加载 ~/.zshrc 的进程）
# ============================================================
if command -v mise &>/dev/null && [[ ! -o interactive ]]; then
    eval "$(mise activate zsh --shims)"
fi
(( $+functions[_prof] )) && _prof "zprofile DONE"
