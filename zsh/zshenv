# ============================================================
# [TEMPLATE] zsh/zshenv - 环境变量（所有 shell 加载）
#
# 部署目标: ~/.zshenv（由 bin/deploy.sh init 处理占位符替换后写入）
#
# AI 规则:
#   - 此文件是仓库模板，含两个占位符 __STORAGE_ROOT__ / __DOTFILES_ROOT__。
#   - AI 部署时调用 bin/deploy.sh init <STORAGE_ROOT>，绝不手写 sed 命令。
#   - 禁止把部署版（~/.zshenv 内绝对路径）回写到本文件。
#   - 仅放环境变量和 PATH，不放别名 / 函数 / prompt 初始化。
#   - 交互式 shell 配置 -> dotfiles/init.zsh -> ~/.zsh/init.zsh
#   - 禁止 export STORAGE_ROOT。
# ============================================================

# ============================================================
# 仓库路径（zimfw 用于加载 init.zsh 本地模块）
# 部署时由 AI 将 __DOTFILES_ROOT__ 替换为 dotfiles 仓库绝对路径
# ============================================================
export DOTFILES_ROOT="__DOTFILES_ROOT__"

# ============================================================
# Profile 调试（ZSH_PROFILE=1 启用，平时无任何开销）
# 详见 debug/profile.zsh 顶部用法
# 真值判断：(( )) 算术求值，ZSH_PROFILE=0 或 unset 均关闭。
# 不能用 [[ -n $ZSH_PROFILE ]]——"0" 是非空字符串会误判为开启。
# ============================================================
if (( ${ZSH_PROFILE:-0} )) && [[ -f $DOTFILES_ROOT/debug/profile.zsh ]]; then
    source $DOTFILES_ROOT/debug/profile.zsh
    _prof "zshenv start (after DOTFILES_ROOT)"
fi

# ============================================================
# 存储根：以下两行 export 在仓库内为占位符，部署时由 AI 全文替换为绝对路径（见 README）。
# 禁止 export STORAGE_ROOT 环境变量。固定子目录：Code/、Languages/
# 换位置见 README「存储位置与迁移」
# ============================================================
export CODE_LANGUAGES_HOME="__STORAGE_ROOT__/Languages"

