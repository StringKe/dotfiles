# ============================================================
# Homebrew
# PATH 在本文件独占。zprofile 取完 brew shellenv 的 HOMEBREW_* 后再调
# _dotfiles_setup_path，抵消 path_helper / brew 把 /usr/bin 抬到最前。
# 安装器 caveats 禁止留在 ~/.zshrc；按是否该盖住系统命令分层加入。
# ============================================================
if [[ -z ${HOMEBREW_PREFIX:-} ]]; then
    if [[ -x /opt/homebrew/bin/brew ]]; then
        HOMEBREW_PREFIX=/opt/homebrew
    elif [[ -x /usr/local/bin/brew ]]; then
        HOMEBREW_PREFIX=/usr/local
    else
        HOMEBREW_PREFIX=/opt/homebrew
    fi
fi
export HOMEBREW_PREFIX

# keg-only CLI 目录在 _dotfiles_setup_path 里收集，便于登录壳在 path_helper 之后重建。

# ============================================================
# 编译环境变量 (LDFLAGS / CPPFLAGS / PKG_CONFIG_PATH)
# 只收录 keg-only 库。已 link 进 prefix 的（zstd / libzip）不必再写。
# llvm 不进默认 flags，避免盖住 Apple clang 的 headers。需要时在项目里单独加。
# ============================================================
KEG_ONLY_LIBS=(
    openssl@3
    readline
    sqlite
    libpq
    ncurses
    icu4c
    curl
    krb5
    openldap
    libffi
    libxml2
    ffmpeg-full
    mysql-client
)

_ldflags=""
_cppflags=""
_pkg_config_path=""
for lib in "${KEG_ONLY_LIBS[@]}"; do
    if [[ -d $HOMEBREW_PREFIX/opt/$lib/lib ]]; then
        _ldflags="$_ldflags -L$HOMEBREW_PREFIX/opt/$lib/lib"
    fi
    if [[ -d $HOMEBREW_PREFIX/opt/$lib/include ]]; then
        _cppflags="$_cppflags -I$HOMEBREW_PREFIX/opt/$lib/include"
    fi
    if [[ -d $HOMEBREW_PREFIX/opt/$lib/lib/pkgconfig ]]; then
        _pkg_config_path="$_pkg_config_path:$HOMEBREW_PREFIX/opt/$lib/lib/pkgconfig"
    fi
done
export LDFLAGS="${_ldflags# }"
export CPPFLAGS="${_cppflags# }"
export PKG_CONFIG_PATH="${_pkg_config_path#:}"
unset _ldflags _cppflags _pkg_config_path lib
unset KEG_ONLY_LIBS

# ============================================================
# 语言编译选项 (mise 编译 Ruby/Python 时使用)
# ============================================================
export RUBY_CONFIGURE_OPTS="--with-openssl-dir=$HOMEBREW_PREFIX/opt/openssl@3 --with-readline-dir=$HOMEBREW_PREFIX/opt/readline"
export PYTHON_CONFIGURE_OPTS="--with-openssl=$HOMEBREW_PREFIX/opt/openssl@3"

# ============================================================
# PATH
# 用户 CLI 安装器常把 export PATH 追加进 ~/.zshrc / ~/.zprofile，部署会覆盖。
# 登录壳会跑 /etc/zprofile 的 path_helper，把 /usr/bin 抬到最前，盖住
# macos-trash / ffmpeg-full。zprofile 在 brew shellenv 之后再调本函数重建。
# ============================================================
if [[ -d $HOME/.vite-plus ]]; then
    export VP_HOME="$HOME/.vite-plus"
fi

_dotfiles_setup_path() {
    # -g：函数内 typeset 默认是 local，否则 PATH 改完就丢
    typeset -gU path
    local -a _user_cli _keg_front _keg_behind
    local _d _keg

    for _d in \
        "$HOME/.local/bin" \
        "$HOME/.opencode/bin" \
        "$HOME/.darkbloom/bin" \
        "$HOME/.lmstudio/bin" \
        "$HOME/.maestro/bin" \
        "$HOME/.orbstack/bin" \
        "$HOME/.yzos/bin" \
        "$HOME/Library/Application Support/JetBrains/Toolbox/scripts"
    do
        [[ -d "$_d" ]] && _user_cli+=("$_d")
    done
    # kimi-code / kimi-webbridge / kimi-work 等安装器各自写 ~/.kimi-*/bin
    for _d in "$HOME"/.kimi-*/bin; do
        [[ -d "$_d" ]] && _user_cli+=("$_d")
    done

    # 必须盖住系统/普通公式：ffmpeg-full、macos-trash、mysql-client、较新的 curl/sqlite
    for _keg in ffmpeg-full mysql-client macos-trash libpq curl sqlite icu4c; do
        [[ -d $HOMEBREW_PREFIX/opt/$_keg/bin ]] && _keg_front+=("$HOMEBREW_PREFIX/opt/$_keg/bin")
        [[ -d $HOMEBREW_PREFIX/opt/$_keg/sbin ]] && _keg_front+=("$HOMEBREW_PREFIX/opt/$_keg/sbin")
    done

    # 不把 coreutils gnubin 放在 /usr/bin 之前：GNU stat/date/mktemp 会让
    # kimi/opencode 的 install.sh（按 BSD 语义写的）升级失败。不冲突的短名
    # （timeout/nproc 等）已由 brew coreutils 链到 $HOMEBREW_PREFIX/bin。
    # 需要 GNU date 用 gdate。不加 libtool gnubin。
    #
    # Vite+ bin 含 node/npm -> vp 的 shim，不能放前面，否则盖住 mise node。
    # vp 本身在 keg_behind 仍能找到。
    [[ -d $HOME/.vite-plus/bin ]] && _keg_behind+=("$HOME/.vite-plus/bin")

    # 系统命令之后：llvm-config/clang-format、bsdtar 旁路、ncursesw6-config。
    # clang 仍是 /usr/bin/clang；tar/clear 仍是系统的。
    # 不把 openjdk / python@*/libexec 放进 PATH：JAVA_HOME 与 python 走 mise/uv。
    for _keg in llvm ncurses libarchive; do
        [[ -d $HOMEBREW_PREFIX/opt/$_keg/bin ]] && _keg_behind+=("$HOMEBREW_PREFIX/opt/$_keg/bin")
        [[ -d $HOMEBREW_PREFIX/opt/$_keg/sbin ]] && _keg_behind+=("$HOMEBREW_PREFIX/opt/$_keg/sbin")
    done

    path=(
        "${_user_cli[@]}"
        "$HOME/.proto/bin"
        "$HOME/.proto/shims"
        "$HOME/.moon/bin"
        "$CARGO_HOME/bin"
        "$GOBIN"
        "$NPM_CONFIG_PREFIX/bin"
        "$PNPM_HOME/bin"
        "$YARN_GLOBAL_FOLDER/bin"
        "$BUN_INSTALL/bin"
        "$DENO_INSTALL/bin"
        "$PIPX_BIN_DIR"
        "$UV_TOOL_BIN_DIR"
        "$COMPOSER_HOME/vendor/bin"
        "${_keg_front[@]}"
        "$HOMEBREW_PREFIX/bin"
        "$HOMEBREW_PREFIX/sbin"
        /usr/local/bin
        /usr/bin
        /bin
        /usr/sbin
        /sbin
        "${_keg_behind[@]}"
        $path
    )
    export PATH
}

_dotfiles_setup_path

# ============================================================
# fpath 修复 - Homebrew zsh bottle relocation 缺陷
# 部分 zsh bottle 编译进的默认 fpath 含带完整版本号的目录（如
# share/zsh/5.9.1/functions），relocation 丢失 patch 号后指向不存在的路径，
# 导致 is-at-least / compinit 等核心函数无法 autoload、zimfw 启动报版本错误。
# prepend 版本无关的稳定 symlink 目录修复（目录不存在则跳过）。
# ============================================================
typeset -U fpath
if [[ -d $HOMEBREW_PREFIX/share/zsh/functions ]]; then
    fpath=($HOMEBREW_PREFIX/share/zsh/functions $fpath)
fi

# Grok Build CLI：关闭 telemetry / codebase upload（优先级高于 config）
[[ -f $HOME/.grok/privacy.env ]] && source "$HOME/.grok/privacy.env"

(( $+functions[_prof] )) && _prof "zshenv DONE"
