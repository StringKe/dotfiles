# [TEMPLATE] templates/zsh_secrets.template
# 部署目标: ~/.zsh_secrets（由 bin/deploy.sh init 复制，权限 600）
#
# AI 规则:
#   - 此文件是空白模板，仅当 ~/.zsh_secrets 不存在时复制。
#   - 部署版含实际密钥，绝不进 git。
#   - AI 不得把实际密钥回写本模板。

# GitHub
export GITHUB_TOKEN=""

# OpenAI / Anthropic 等模型 key 不放这里：用 magpie provider add 存进 magpie，
# 也不在这里设置 ANTHROPIC_* / OPENAI_*，否则会盖住 magpie 写进各 agent 配置的网关地址。

# AWS
export AWS_ACCESS_KEY_ID=""
export AWS_SECRET_ACCESS_KEY=""
export AWS_DEFAULT_REGION=""

# Work Docs
export WORK_DOCS_DIR=""
export WORK_REPORTS_DIR=""
