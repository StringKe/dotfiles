# [TEMPLATE] templates/zsh_secrets.template
# 部署目标: ~/.zsh_secrets（bin/deploy.sh init 仅在不存在时复制，权限 600）
# 由 zsh/zshenv source，非交互进程也能读到。部署版含实际密钥，不进 git，也不回写本模板。
# 本机私有配置（如 ~/.config/opencode/opencode.json 里的模型 provider）用到的 key 也写在部署版里，不写进本模板。

# MCP（ai/claude/mcp.json 写 ${VAR}，ai/opencode/opencode.jsonc 写 {env:VAR}）
export MCP_CONTEXT7_API_KEY=""
export MCP_EXA_API_KEY=""
# https://app.openseo.so -> Settings -> API keys
export OPENSEO_API_KEY=""
# https://sentry.io/settings/account/api/auth-tokens/ 个人 token，scope: org:read project:write team:write event:write
export SENTRY_ACCESS_TOKEN=""
# https://dashboard.fingerprint.com -> API keys，Server API secret key 与 Management API key
export FINGERPRINT_SERVER_API_KEY=""
export FINGERPRINT_MANAGEMENT_API_KEY=""
